server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate {{ .CertificatePath }};
    ssl_certificate_key {{ .KeyPath }};

    root {{ .WebRoot }};
{{ if .SubscriptionInSiteBlock }}{{ template "subscription" . }}
{{ end }}
{{ if and .PublicMonitor .EnableMonitor .MonitorSharesSiteBlock }}
{{ if .EnableMonitorFrontend }}
    location /monitor/ {
        proxy_pass http://127.0.0.1:{{ .MonitorPort }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
{{ end }}
    location /monitor/api/ {
        proxy_pass http://127.0.0.1:{{ .MonitorPort }}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
{{ end }}
    location / {
        try_files $uri $uri/ /index.html;
    }
}

{{ if .SubscriptionOwnBlock }}
server {
    listen {{ .SubscribePort }} ssl;
    http2 on;
    server_name {{ .SubscriptionDomain }};

    ssl_certificate {{ .SubscriptionCertificatePath }};
    ssl_certificate_key {{ .SubscriptionKeyPath }};

    root {{ .WebRoot }};
{{ template "subscription" . }}

    location / {
        try_files $uri $uri/ /index.html;
    }
}
{{ end }}
{{ if and .PublicMonitor .EnableMonitor (not .MonitorSharesSiteBlock) }}
server {
    listen {{ .MonitorPublicPort }} ssl;
    http2 on;
    server_name {{ .MonitorDomain }};

    ssl_certificate {{ .MonitorCertificatePath }};
    ssl_certificate_key {{ .MonitorKeyPath }};
{{ if .SubscriptionInMonitorBlock }}{{ template "subscription" . }}
{{ end }}
{{ if .EnableMonitorFrontend }}
    location = / {
        return 302 /monitor/;
    }

    location /monitor/ {
        proxy_pass http://127.0.0.1:{{ .MonitorPort }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
{{ end }}
    location /monitor/api/ {
        proxy_pass http://127.0.0.1:{{ .MonitorPort }}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
{{ end }}
{{ if or .SubscriptionRejectBlock .MonitorRejectBlock }}
# The subscription and monitor ports answer only to the name they publish. Any
# other SNI (or none, such as a bare-address probe) is dropped during the
# handshake, so neither can be reached through the masquerade site's name and
# the port reveals no certificate. On 443 these blocks are unnecessary: the
# camouflage server is already that port's default server. A port that serves
# both endpoints takes only one, since Nginx allows a single default server per
# port.
{{ end }}
{{ if .SubscriptionRejectBlock }}
server {
    listen {{ .SubscribePort }} ssl default_server;
    server_name _;

    ssl_reject_handshake on;
    return 444;
}
{{ end }}
{{ if .MonitorRejectBlock }}
server {
    listen {{ .MonitorPublicPort }} ssl default_server;
    server_name _;

    ssl_reject_handshake on;
    return 444;
}
{{ end }}
{{- define "subscription" }}
    # A plain subscription link is a static file. A link with a query string,
    # such as one asking for Tailscale mode, is answered by the loopback
    # subscription service, which reads the same file and rewrites it.
    location /s/ {
        error_page 418 = @subscription_dynamic;
        if ($args) {
            return 418;
        }
        alias {{ .SubscribeDir }}/;
        default_type text/plain;
        charset utf-8;
    }

    # Named, so the original URI and query reach the service unchanged. The
    # query can carry a Tailscale auth key, so these requests are never logged:
    # upstream errors would otherwise copy the request line into the error log,
    # and a large response would be spooled to a temporary file. The service
    # logs its own failures to the journal.
    location @subscription_dynamic {
        access_log off;
        error_log /dev/null crit;
        proxy_max_temp_file_size 0;
        proxy_pass http://127.0.0.1:{{ .SubscriptionServicePort }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
{{- end }}
