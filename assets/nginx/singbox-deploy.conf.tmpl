server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate {{ .CertificatePath }};
    ssl_certificate_key {{ .KeyPath }};

    root {{ .WebRoot }};
{{ if .SubscriptionInSiteBlock }}
    location /s/ {
        alias {{ .SubscribeDir }}/;
        default_type text/plain;
        charset utf-8;
    }
{{ end }}
{{ if and .PublicMonitor .EnableMonitor .MonitorSharesSiteBlock }}
{{ if .EnableMonitorFrontend }}
    location /monitor/ {
        proxy_pass http://127.0.0.1:{{ .MonitorPort }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
{{ end }}
    location /monitor/api/ {
        proxy_pass http://127.0.0.1:{{ .MonitorPort }}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
{{ end }}
    location / {
        try_files $uri $uri/ /index.html;
    }
}

{{ if .SubscriptionOwnBlock }}
server {
    listen {{ .SubscribePort }} ssl;
    http2 on;
    server_name {{ .SubscriptionDomain }};

    ssl_certificate {{ .SubscriptionCertificatePath }};
    ssl_certificate_key {{ .SubscriptionKeyPath }};

    root {{ .WebRoot }};

    location /s/ {
        alias {{ .SubscribeDir }}/;
        default_type text/plain;
        charset utf-8;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
{{ end }}
{{ if and .PublicMonitor .EnableMonitor (not .MonitorSharesSiteBlock) }}
server {
    listen {{ .MonitorPublicPort }} ssl;
    http2 on;
    server_name {{ .MonitorDomain }};

    ssl_certificate {{ .MonitorCertificatePath }};
    ssl_certificate_key {{ .MonitorKeyPath }};
{{ if .SubscriptionInMonitorBlock }}
    location /s/ {
        alias {{ .SubscribeDir }}/;
        default_type text/plain;
        charset utf-8;
    }
{{ end }}
{{ if .EnableMonitorFrontend }}
    location = / {
        return 302 /monitor/;
    }

    location /monitor/ {
        proxy_pass http://127.0.0.1:{{ .MonitorPort }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
{{ end }}
    location /monitor/api/ {
        proxy_pass http://127.0.0.1:{{ .MonitorPort }}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
{{ end }}
{{ if and .PublicMonitor .EnableMonitor (ne .MonitorPublicPort 443) }}
# The monitor port answers only to the monitor's own name. Any other SNI (or
# none, such as a bare-address probe) is dropped during the handshake, so the
# monitor cannot be reached through the masquerade site's name and the port
# reveals no certificate. On 443 this block is unnecessary: the camouflage
# server is already that port's default server.
server {
    listen {{ .MonitorPublicPort }} ssl default_server;
    server_name _;

    ssl_reject_handshake on;
    return 444;
}
{{ end }}
